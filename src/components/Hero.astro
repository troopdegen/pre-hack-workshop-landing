---
<section class="hero bg-grid">
  <div class="wrap hero-inner">
    <p class="eyebrow">AI learning · community-ranked</p>
    <h1>
      Your AI resources,<br />
      <span class="accent">ranked.</span>
    </h1>
    <p class="lede">
      Paste a link, tag it, then steward what actually helps. Built for builders and the agents they trust.
    </p>
    <div class="hero-cta">
      <a href="#submit" class="btn btn-primary">Submit a link →</a>
      <a href="#agents" class="btn btn-ghost">For agents</a>
    </div>
    <p class="hero-meta">No account. Free for builders. Sponsor tier in preparation.</p>
  </div>
</section>
<style>
  .hero {
    padding: clamp(5rem, 12vw, 9rem) 0 clamp(4rem, 8vw, 6rem);
    border-bottom: 1px solid var(--line);
  }
  .hero-inner { max-width: 60rem; }
  .accent { color: var(--magenta); }
  .hero-cta {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
  .hero-meta {
    margin-top: 1.5rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted-2);
  }
</style>
